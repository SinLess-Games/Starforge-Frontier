{
  "name": "starforge-frontier",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Starforge Frontier prototype built with TypeScript, Vite, React, Babylon.js, and Tauri.",
  "author": "SinLess Games LLC",
  "license": "UNLICENSED",
  "packageManager": "pnpm@11.5.2",
  "engines": {
    "node": ">=22.12.0",
    "pnpm": ">=11.0.0"
  },
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host 0.0.0.0",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "tauri": "tauri",
    "desktop:dev": "tauri dev",
    "desktop:build": "tauri build",
    "clean": "rm -rf dist coverage .vite"
  },
  "dependencies": {
    "@babylonjs/core": "^9.11.0",
    "@babylonjs/gui": "^9.11.0",
    "@babylonjs/havok": "^1.3.12",
    "@babylonjs/loaders": "^9.11.0",
    "@babylonjs/materials": "^9.11.0",
    "@series-inc/rundot-game-sdk": "^5.20.0",
    "@tauri-apps/api": "^2.11.0",
    "bitecs": "^0.4.0",
    "colyseus.js": "^0.16.22",
    "firebase": "^12.14.0",
    "howler": "^2.2.4",
    "idb-keyval": "^6.2.5",
    "miniplex": "^2.0.0",
    "nanoid": "^5.1.11",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "recast-navigation": "^0.43.1",
    "rxdb": "^17.3.0",
    "seedrandom": "^3.0.5",
    "simplex-noise": "^4.0.3",
    "zod": "^4.4.3",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@babylonjs/inspector": "^9.11.0",
    "@eslint/js": "^10.0.1",
    "@gltf-transform/cli": "^4.4.0",
    "@gltf-transform/core": "^4.4.0",
    "@gltf-transform/functions": "^4.4.0",
    "@tauri-apps/cli": "^2.11.2",
    "@types/howler": "^2.2.13",
    "@types/node": "^25.9.2",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.2",
    "autoprefixer": "^10.5.0",
    "eslint": "^10.4.1",
    "globals": "^17.6.0",
    "jiti": "^2.7.0",
    "jsdom": "^29.1.1",
    "postcss": "^8.5.15",
    "prettier": "^3.8.3",
    "sass": "^1.100.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.61.0",
    "vite": "^8.1.6",
    "vitest": "^4.1.8"
  }
}
